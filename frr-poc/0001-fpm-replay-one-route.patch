+/**
+ * Re-send one installed route to the data plane.
+ *
+ * The reconnect walk above already regenerates a route's FPM message from
+ * dest->selected_fib; what it cannot do is name one destination. This does
+ * only that, and calls the same encoder.
+ *
+ * Everything happens on zrouter.master, synchronously, with the route node's
+ * reference held from lookup to enqueue. No rib_dest is handed to another
+ * thread -- the failure that would otherwise define this function is to look
+ * up a destination, release it, let a protocol replace the route, and then
+ * encode from freed memory.
+ *
+ * srcdest_rnode_lookup(), not _get(): _get creates the node when it is absent,
+ * and repairing a prefix the RIB does not have must fail rather than conjure
+ * an empty destination.
+ *
+ * Returns 0 on success, or a negative errno-style code naming the reason. A
+ * caller cannot act on "it did not work".
+ */
+static int fpm_rib_replay_one(struct fpm_nl_ctx *fnc, vrf_id_t vrf_id,
+			      const struct prefix *p)
+{
+	struct zebra_dplane_ctx *ctx;
+	struct route_table *table;
+	struct route_node *rn;
+	rib_dest_t *dest;
+	afi_t afi;
+	int rv;
+
+	if (fnc->socket == -1 || fnc->connecting)
+		return -ENOTCONN;
+
+	afi = family2afi(p->family);
+	if (afi != AFI_IP && afi != AFI_IP6)
+		return -EAFNOSUPPORT;
+
+	table = zebra_vrf_table(afi, SAFI_UNICAST, vrf_id);
+	if (table == NULL)
+		return -ENOENT;
+
+	rn = srcdest_rnode_lookup(table, p, NULL);
+	if (rn == NULL)
+		return -ESRCH;
+
+	dest = rib_dest_from_rnode(rn);
+	if (dest == NULL || dest->selected_fib == NULL) {
+		route_unlock_node(rn);
+		return -ENODATA;
+	}
+
+	ctx = dplane_ctx_alloc();
+	rv = fpm_rib_send_one(fnc, ctx, rn, dest);
+	dplane_ctx_fini(&ctx);
+	route_unlock_node(rn);
+
+	return rv == 0 ? 0 : -ENOBUFS;
+}
