 /**
+ * Encode one installed route and hand it to the FPM output buffer.
+ *
+ * This is the body of the RIB walk below, lifted out unchanged so that a
+ * single destination can be sent without walking anything. Extracted rather
+ * than copied on purpose: a repair that encoded routes its own way would
+ * program a route into a state the next reconnect walk disagrees with.
+ *
+ * Runs on zrouter.master, which owns the RIB. fpm_nl_enqueue() takes
+ * fnc->obuf_mutex, so the output buffer is safe against the FPM thread.
+ *
+ * Returns 0 when the route was enqueued, -1 when the output buffer is full.
+ */
+static int fpm_rib_send_one(struct fpm_nl_ctx *fnc,
+			    struct zebra_dplane_ctx *ctx,
+			    struct route_node *rn, rib_dest_t *dest)
+{
+	dplane_ctx_reset(ctx);
+	dplane_ctx_route_init(ctx, DPLANE_OP_ROUTE_INSTALL, rn,
+			      dest->selected_fib);
+	if (fpm_nl_enqueue(fnc, ctx) == -1)
+		return -1;
+
+	SET_FLAG(dest->flags, RIB_DEST_UPDATE_FPM);
+	return 0;
+}
+
