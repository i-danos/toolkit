+/*
+ * Experimental. This exists to answer one question -- can a single route be
+ * repaired without restarting anything -- and its name and syntax are not a
+ * commitment. The command runs on the same thread as the RIB, so the lookup,
+ * the encode and the enqueue all happen before it answers.
+ */
+DEFPY(fpm_route_replay, fpm_route_replay_cmd,
+      "fpm route-replay <A.B.C.D/M|X:X::X:X/M>$prefix [vrf NAME$vrfname]",
+      FPM_STR
+      "Re-send one installed route to the FPM (experimental)\n"
+      "IPv4 prefix\n"
+      "IPv6 prefix\n"
+      VRF_CMD_HELP_STR
+      VRF_CMD_HELP_STR)
+{
+	vrf_id_t vrf_id = VRF_DEFAULT;
+	struct vrf *vrf;
+	int rv;
+
+	if (vrfname) {
+		vrf = vrf_lookup_by_name(vrfname);
+		if (vrf == NULL) {
+			vty_out(vty, "%% No such routing instance: %s\n",
+				vrfname);
+			return CMD_WARNING;
+		}
+		vrf_id = vrf->vrf_id;
+	}
+
+	rv = fpm_rib_replay_one(gfnc, vrf_id, (const struct prefix *)prefix);
+	switch (rv) {
+	case 0:
+		vty_out(vty, "%% Re-sent %pFX to the FPM\n", prefix);
+		return CMD_SUCCESS;
+	case -ENOTCONN:
+		vty_out(vty, "%% No FPM connection\n");
+		break;
+	case -EAFNOSUPPORT:
+		vty_out(vty, "%% Unsupported address family\n");
+		break;
+	case -ENOENT:
+		vty_out(vty, "%% No routing table for that instance\n");
+		break;
+	case -ESRCH:
+		vty_out(vty, "%% %pFX is not in the RIB\n", prefix);
+		break;
+	case -ENODATA:
+		vty_out(vty, "%% %pFX is in the RIB but nothing is installed\n",
+			prefix);
+		break;
+	case -ENOBUFS:
+		vty_out(vty, "%% FPM output buffer is full\n");
+		break;
+	default:
+		vty_out(vty, "%% Failed (%d)\n", rv);
+		break;
+	}
+	return CMD_WARNING;
+}
+
